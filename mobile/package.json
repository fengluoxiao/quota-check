    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-modules-core": "~58.1.0",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "~19.3.0",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
